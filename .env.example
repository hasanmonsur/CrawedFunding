NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://crowdfund360:crowdfund360@localhost:5432/crowdfund360
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=crowdfund360-dev
LOG_LEVEL=debug

# Payment provider callback secrets.
# Leave unset for local foundation checks: the provider registry then loads a clearly
# synthetic placeholder secret and no provider is enabled for live money movement.
# Never commit a real provider secret to this file.
SYNTHETIC_BANK_API_CALLBACK_SECRET=
SYNTHETIC_MFS_CALLBACK_SECRET=
